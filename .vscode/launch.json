{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "args": [
        "-c",
        "config",
        "--debug"
      ],
      "justMyCode": false,
      "preLaunchTask": "Setup",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "python": "${workspaceFolder}/.venv/bin/python",
      "subProcess": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-x",
        "--no-cov"
      ],
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}
